        {
          "name": "GET /api/v1/feeds/google-merchant-center.xml",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{feedToken}}",
                "description": "Override the collection-root auth: feeds use a feed-scoped token (gmc_...), not your mba_live_... key. Mint it in the admin's Feeds tab."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/feeds/google-merchant-center.xml?shop={{shopDomain}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "feeds", "google-merchant-center.xml"],
              "query": [
                {
                  "key": "shop",
                  "value": "{{shopDomain}}",
                  "description": "Your shop domain. Optional, the token is scoped to a shop already."
                },
                {
                  "key": "api_key",
                  "value": "{{feedToken}}",
                  "description": "Fallback for Google Merchant Center's scheduled fetcher (no custom headers supported). Prefer Authorization: Bearer.",
                  "disabled": true
                }
              ]
            },
            "description": "Public Google-Merchant-Center-compatible product feed. RSS 2.0 with `g:` namespace, plus our mined `substitutes` and `compatible_accessories` as structured product detail blocks for Google AI Mode + ChatGPT Shopping.\n\n**Auth scheme:** feed token (`gmc_...`), NOT your `mba_live_...` API key. Set `feedToken` before sending. Either pass it as `Authorization: Bearer` (preferred) or as `?api_key=` (acceptable, required for GMC's scheduled fetcher which doesn't support custom headers).\n\n**Tier:** Pro plan only. Starter shops get a 402.\n\nCookbook: see the Shopify feeds docs at https://marketbasketanalysis.com/docs."
          },
          "response": [
            {
              "name": "200 OK (sample feed)",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{feedToken}}" }],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/feeds/google-merchant-center.xml?shop={{shopDomain}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "feeds", "google-merchant-center.xml"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "xml",
              "header": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }],
              "cookie": [],
              "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rss version=\"2.0\" xmlns:g=\"http://base.google.com/ns/1.0\">\n  <channel>\n    <title>your-shop.myshopify.com - MarketBasketAnalysis product feed</title>\n    <link>https://your-shop.myshopify.com</link>\n    <description>MBA-enriched product feed for Google Merchant Center.</description>\n    <item>\n      <g:id>SKU-001</g:id>\n      <g:title>Camera Cleaning Kit</g:title>\n      <g:price>24.99 USD</g:price>\n      <g:availability>in stock</g:availability>\n      <g:product_detail>\n        <g:section_name>Compatible Accessories</g:section_name>\n        <g:attribute_name>frequently bought with</g:attribute_name>\n        <g:attribute_value>Lens Filter Kit, Camera Strap</g:attribute_value>\n      </g:product_detail>\n    </item>\n  </channel>\n</rss>"
            },
            {
              "name": "401 Unauthorized (bad token)",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer gmc_invalid" }],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/feeds/google-merchant-center.xml",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "feeds", "google-merchant-center.xml"]
                }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "text",
              "header": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }],
              "cookie": [],
              "body": "Invalid or revoked feed token"
            },
            {
              "name": "402 Payment Required (Starter tier)",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{feedToken}}" }],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/feeds/google-merchant-center.xml",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "feeds", "google-merchant-center.xml"]
                }
              },
              "status": "Payment Required",
              "code": 402,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"error\": \"tier_required\",\n  \"required_tier\": \"pro\",\n  \"upgrade_url\": \"https://marketbasketanalysis.com/pricing\"\n}"
            }
          ]
        },
