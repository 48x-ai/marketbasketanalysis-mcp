{
  "name": "@marketbasketanalysis/mcp",
  "version": "0.7.0",
  "description": "MCP server for MarketBasketAnalysis. 19 tools for AI shopping, merchant ops, B2B agents: recommendations, substitutes, cart bundle completion, rationale, cross-sell scoring, basket cohesion, return risk, reorder prediction, subscription kits, weekly plan, opportunity triage, opportunity + drift explanations, drift + forecast alerts, bundle forecasting, HUI mining. Works with Claude Desktop, Claude Code, Cursor, Windsurf, Cline, the OpenAI Agent SDK, and Smithery.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "mcpName": "io.github.48x-ai/marketbasketanalysis-mcp",
  "bin": {
    "mba-mcp": "dist/index.js",
    "mba-mcp-http": "dist/http.js",
    "marketbasketanalysis-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "smithery.yaml"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anthropic",
    "claude",
    "claude-desktop",
    "cursor",
    "windsurf",
    "smithery",
    "shopping",
    "ecommerce",
    "market-basket-analysis",
    "recommendations",
    "substitutes",
    "shopify",
    "magento",
    "woocommerce",
    "bigcommerce",
    "openai",
    "agents",
    "agent-tools",
    "agentic-commerce",
    "cross-sell",
    "bundles",
    "frequently-bought-together",
    "rationale",
    "weekly-plan",
    "opportunities",
    "drift-detection",
    "forecast",
    "holt-winters",
    "hui-mining",
    "high-utility-itemsets",
    "b2b",
    "reorder-prediction"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@sentry/node": "^10.54.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/48x-ai/marketbasketanalysis-mcp.git"
  },
  "homepage": "https://marketbasketanalysis.com",
  "bugs": {
    "url": "https://github.com/48x-ai/marketbasketanalysis/issues"
  },
  "author": "48x.ai LLC <brian@48x.ai>"
}
